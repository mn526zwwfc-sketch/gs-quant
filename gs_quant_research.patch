+        GrowthStrategyConfig(buffer=0.5)
+    with pytest.raises(MqValueError):
+        GrowthStrategyConfig(growth_quantile=0)
+    with pytest.raises(MqValueError):
+        GrowthStrategyConfig(min_margin_of_safety=0.1, hold_margin_of_safety=0.2)
